# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — resend.com → API Keys
RESEND_API_KEY=
# Opcional: dirección verificada para enviar. Si se deja vacío, usa el
# dominio de prueba de Resend (onboarding@resend.dev).
RESEND_FROM_EMAIL=

# Mail de la admin donde llega el aviso de "nuevo presupuesto"
ADMIN_NOTIFICATION_EMAIL=

# URL pública del sitio (usada en el link del mail de aviso)
NEXT_PUBLIC_SITE_URL=https://bajoctrl.com.ar
